<Page x:Class="BalahninLibrary.LibraryFundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BalahninLibrary"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LibraryFundPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтра -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BackButton" Content="← Назад" Width="80" Height="25" 
                    Margin="0,0,15,0" Click="BackButton_Click"/>
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="SearchTextBox" Width="240" Margin="0,0,20,0"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Поиск по названию фонда или библиотеки"/>

            <TextBlock Text="Библиотека:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="LibraryComboBox" Width="280"
                      SelectionChanged="LibraryComboBox_SelectionChanged">
                <ComboBoxItem Content="Все библиотеки"/>
            </ComboBox>
        </WrapPanel>

        <!-- Кнопка обновления -->
        <Button Grid.Row="1" Content="Обновить" Width="120"
                HorizontalAlignment="Left" Margin="0,0,0,8"
                Click="Refresh_Click"/>

        <!-- Таблица фондов -->
        <ListView Grid.Row="2" x:Name="ListViewFunds"
                  SelectionMode="Single"
                  GridViewColumnHeader.Click="GridViewColumnHeader_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" Width="50"
                                    DisplayMemberBinding="{Binding FundID}"/>
                    <GridViewColumn Header="Фонд" Width="200"
                                    DisplayMemberBinding="{Binding FundName}"/>
                    <GridViewColumn Header="Библиотека" Width="240"
                                    DisplayMemberBinding="{Binding Library.Name}"/>
                    <GridViewColumn Header="Книги" Width="80"
                                    DisplayMemberBinding="{Binding BookCount}"/>
                    <GridViewColumn Header="Журналы" Width="80"
                                    DisplayMemberBinding="{Binding JournalCount}"/>
                    <GridViewColumn Header="Газеты" Width="80"
                                    DisplayMemberBinding="{Binding NewspaperCount}"/>
                    <GridViewColumn Header="Сборники" Width="80"
                                    DisplayMemberBinding="{Binding CollectionCount}"/>
                    <GridViewColumn Header="Диссертации" Width="100"
                                    DisplayMemberBinding="{Binding DissertationCount}"/>
                    <GridViewColumn Header="Рефераты" Width="80"
                                    DisplayMemberBinding="{Binding AbstractCount}"/>
                    <GridViewColumn Header="Всего" Width="90"
                                    DisplayMemberBinding="{Binding TotalCount}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Итоговая строка -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,6,0,0">
            <TextBlock x:Name="SummaryTextBlock"
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>
        </Border>

    </Grid>
</Page>
