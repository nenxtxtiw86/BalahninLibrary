<Window x:Class="BalahninLibrary.AddLibraryItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление экземпляра" Height="760" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}">

    <Grid Margin="25,25,25,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Тип -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Название -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Автор -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Издательство -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Год -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Кол-во -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Фонд -->
            <RowDefinition Height="Auto"/>
            <!-- 7: Пустота / кнопки -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- 0: Тип литературы (ПЕРВЫЙ) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Тип литературы:" Margin="0,0,0,5"/>
            <ComboBox x:Name="TypeComboBox" DisplayMemberPath="TypeName" SelectionChanged="TypeComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- 1: Название -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Название:" Margin="0,0,0,5"/>
            <TextBox x:Name="TbTitle"/>
        </StackPanel>

        <!-- 2: Автор (скрывается для некоторых типов) -->
        <StackPanel Grid.Row="2" x:Name="AuthorPanel" Margin="0,0,0,15">
            <TextBlock Text="Автор:" Margin="0,0,0,5"/>
            <TextBox x:Name="TbAuthor"/>
        </StackPanel>

        <!-- 3: Издательство (скрывается для некоторых типов) -->
        <StackPanel Grid.Row="3" x:Name="PublisherPanel" Margin="0,0,0,15">
            <TextBlock Text="Издательство:" Margin="0,0,0,5"/>
            <TextBox x:Name="TbPublisher"/>
        </StackPanel>

        <!-- 4: Год публикации -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Год публикации (ГГГГ):" Margin="0,0,0,5"/>
            <TextBox x:Name="TbPublicationYear" Text="2024"/>
        </StackPanel>

        <!-- 5: Количество копий -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Кол-во копий:" Margin="0,0,0,5"/>
            <TextBox x:Name="TbCopiesCount" Text="1"/>
        </StackPanel>
        <!-- Выбор библиотеки (виден только директору) -->
        <StackPanel Grid.Row="6" x:Name="LibraryPanel" Margin="0,0,0,15">
            <TextBlock Text="Библиотека:" Margin="0,0,0,5"/>
            <ComboBox x:Name="LibraryComboBox" DisplayMemberPath="Name" SelectionChanged="LibraryComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- Выбор фонда -->
        <StackPanel Grid.Row="7" Margin="0,0,0,15">
            <TextBlock Text="Фонд:" Margin="0,0,0,5"/>
            <ComboBox x:Name="FundComboBox" DisplayMemberPath="FundName"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Сохранить" Width="140" Margin="0,0,10,0" Style="{StaticResource AccentButton}" Click="Save_Click"/>
            <Button Content="Отмена" Width="140" IsCancel="True" Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </Grid>
</Window>