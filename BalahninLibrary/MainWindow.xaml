<Window x:Class="BalahninLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотечная система"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinWidth="1000"
        MinHeight="600"
        Background="{StaticResource Accent}">

    <Grid >
        <Grid.RowDefinitions >
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <Grid Margin="20,0">
                <TextBlock x:Name="TbCurrentUser"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="16"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="BtnArchive"
                            Content="Архив"
                            Width="130"
                            Height="40"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,15,0"
                            Click="OpenArchive_Click"/>
                    <Button x:Name="BtnFunds" Content="Фонды" Width="140" Height="40"
        Style="{StaticResource AccentButton}" Click="OpenFunds_Click"/>
                </StackPanel>
            </Grid>

        <!-- Основная область -->
        <Frame Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="{StaticResource BgMain}"
               HorizontalContentAlignment="Stretch"
               VerticalContentAlignment="Stretch"/>

    </Grid>
</Window>
