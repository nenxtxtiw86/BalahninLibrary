<Page x:Class="BalahninLibrary.ArchivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignWidth="1500"
      d:DesignHeight="800"
      Title="ArchivePage"
      FontFamily="Calibri"
      FontSize="15"
      Background="{StaticResource BgMain}">

    <Grid Margin="20,20,20,0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Первая строка -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Назад"
                            Width="100"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,15,0"
                            Click="Back_Click"/>

                    <TextBox x:Name="SearchTextBox"
                             Width="300"
                             Margin="0,0,15,0"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <Button Content="Очистить фильтры"
                            Width="150"
                            Style="{StaticResource AccentButton}"
                            Click="ClearFilters_Click"/>
                </StackPanel>

                <!-- Фильтр по датам -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Период списания:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="с" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker x:Name="StartDatePicker" Width="150" Margin="0,0,10,0" SelectedDateChanged="DateFilter_Changed"/>
                    <TextBlock Text="по" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker x:Name="EndDatePicker" Width="150" SelectedDateChanged="DateFilter_Changed"/>
                </StackPanel>
            </Grid>

        <!-- Список архива -->
        <ListView Name="ListViewArchive"
                  Grid.Row="1"
                  Margin="0,15,0,0"
                  BorderThickness="0"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="16,14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- ID -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ArchiveID}"
                                   FontWeight="Bold"
                                   FontSize="28"
                                   VerticalAlignment="Top"/>

                        <!-- Основной контент -->
                        <StackPanel Grid.Column="1" Orientation="Vertical">

                            <!-- Название + Инв. номер в одной строке -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="20" 
                                           FontWeight="Bold"
                                           Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding InventoryNumber}"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Автор (скрывается, если пусто) -->
                            <TextBlock Text="{Binding Author}" FontSize="16" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Author}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Author}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Тип, Фонд, Дата списания -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Тип: " FontSize="16"/>
                                <TextBlock Text="{Binding LiteratureType.TypeName}" FontSize="16" Margin="0,0,20,0"/>

                                <TextBlock Text="Фонд: " FontSize="16"/>
                                <TextBlock Text="{Binding LibraryFund.FundName}" FontSize="16" Margin="0,0,20,0"/>

                                <TextBlock Text="Дата списания: " FontSize="16"/>
                                <TextBlock Text="{Binding ArchivedDate, StringFormat={}{0:dd.MM.yyyy}}" FontSize="16"/>
                            </StackPanel>

                            <!-- Причина и кто списал -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Причина: " FontSize="16"/>
                                <TextBlock Text="{Binding Reason}" Foreground="{StaticResource DangerRed}" FontWeight="Bold" FontSize="16" Margin="0,0,20,0"/>

                                <TextBlock Text="Списал(а): " FontSize="16"/>
                                <TextBlock Text="{Binding Employees.FIO}" FontSize="16"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Статус -->
                        <TextBlock Grid.Column="2"
                                   Text="В архиве"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerRed}"
                                   FontSize="16"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,10,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Количество записей -->
        <TextBlock x:Name="CountTextBlock"
                   Grid.Row="2"
                   FontWeight="Bold"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource Accent}"/>

    </Grid>
</Page>