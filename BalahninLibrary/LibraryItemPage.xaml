<Page x:Class="BalahninLibrary.LibraryItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BalahninLibrary"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1200"
      Title="LibraryItemPage" FontSize="15">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel  Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right"  >        
            <!-- Добавь этот код внутрь StackPanel, где находятся твои ComboBox, после FundComboBox -->
             <Button Content="Добавить" Width="100" Height="30" Margin="10,0,10,0" Click="Add_Click"/>
            <Button Content="Списать в архив" Width="120" Height="30" Click="Delete_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10">



            <TextBox x:Name="SearchTextBox" Width="250" Height="30" Margin="0,0,10,0" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"/>
            <ComboBox Name="StatusComboBox" Width="160" Height="30" Margin="0,0,10,0" SelectionChanged="StatusComboBox_SelectionChanged">
                <ComboBoxItem>Все статусы</ComboBoxItem>
                <ComboBoxItem>Активен</ComboBoxItem>
                <ComboBoxItem>В архиве</ComboBoxItem>
            </ComboBox>
            <ComboBox  Name="FundComboBox" Width="250" Height="30" Margin="0,0,10,0" SelectionChanged="FundComboBox_SelectionChanged">
                <ComboBoxItem>Все фонды</ComboBoxItem>
                <ComboBoxItem>Основной фонд</ComboBoxItem>
                <ComboBoxItem>Редкий фонд</ComboBoxItem>
                <ComboBoxItem>Учебный фонд</ComboBoxItem>
                <ComboBoxItem>Периодика</ComboBoxItem>
                <ComboBoxItem>Детский фонд</ComboBoxItem>
                <ComboBoxItem>Научный фонд</ComboBoxItem>
                <ComboBoxItem>Краеведческий фонд</ComboBoxItem>
                <ComboBoxItem>Фонд периодических изданий</ComboBoxItem>
                <ComboBoxItem>Художественный фонд</ComboBoxItem>
                <ComboBoxItem>Фонд редких книг</ComboBoxItem>
                <ComboBoxItem>Справочный фонд</ComboBoxItem>
                <ComboBoxItem>Фонд диссертаций</ComboBoxItem>
                <ComboBoxItem>Фонд рефератов</ComboBoxItem>
                <ComboBoxItem>Учебно-методический фонд</ComboBoxItem>
                <ComboBoxItem>Фонд аудиокниг</ComboBoxItem>
                <ComboBoxItem>Медиатека</ComboBoxItem>
                <ComboBoxItem>Фонд периодики</ComboBoxItem>
                <ComboBoxItem>Молодёжный фонд</ComboBoxItem>
                <ComboBoxItem>Досуговый фонд</ComboBoxItem>
                <ComboBoxItem>Фонд нотных изданий</ComboBoxItem>
            </ComboBox>
        </StackPanel>


        <ListView Name="ListViewLibrary" Grid.Row="1" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <TextBlock Text="{Binding ItemID}" ></TextBlock>
                            <TextBlock Text=" " ></TextBlock>
                            <TextBlock Text="{Binding Title}" ></TextBlock>
                            <TextBlock Text=" | " ></TextBlock>
                            <TextBlock Text="{Binding Author}" ></TextBlock>
                            <TextBlock Text="  " ></TextBlock>
                            <TextBlock Text="{Binding InventoryNumber}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Тип: "></TextBlock>
                            <TextBlock Text="{Binding LiteratureType.TypeName}" ></TextBlock>
                            <TextBlock Text="  |  "></TextBlock>
                            <TextBlock Text="{Binding LibraryFund.FundName}"></TextBlock>
                            <TextBlock Text="  |  "></TextBlock>

                            <TextBlock Text="{Binding AddedDate, StringFormat={}{0:dd.MM.yyyy}}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Добавил(а): "></TextBlock>
                            <TextBlock Text="{Binding Employees.FIO}" ></TextBlock>
                            <TextBlock Text="  "></TextBlock>
                            <TextBlock Text="{Binding Employees.Position}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Статус: "></TextBlock>
                            <TextBlock Text="{Binding Status}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="{Binding LibraryFund.Library.Name}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Издательство: "></TextBlock>
                            <TextBlock Text="{Binding Replenishment.Publisher}" ></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="CountTextBlock" Grid.Row="2" Grid.ColumnSpan="2" FontWeight="Bold" VerticalAlignment="Center"/>
        
    </Grid>
</Page>
