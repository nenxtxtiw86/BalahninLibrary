<Page x:Class="BalahninLibrary.LibraryItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignWidth="1500"
      d:DesignHeight="800"
      Title="LibraryItemPage"
      FontFamily="Calibri"
      FontSize="15"
      Background="{StaticResource BgMain}">

    <Grid Margin="20,20,20,0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchTextBox" Width="300" Margin="0,0,15,0" TextChanged="SearchTextBox_TextChanged"/>
                    <ComboBox Name="StatusComboBox" Width="180" Margin="0,0,15,0" SelectionChanged="StatusComboBox_SelectionChanged">
                        <ComboBoxItem>Все статусы</ComboBoxItem>
                        <ComboBoxItem>Активен</ComboBoxItem>
                        <ComboBoxItem>В архиве</ComboBoxItem>
                    </ComboBox>
                    <ComboBox Name="FundComboBox" Width="280" SelectionChanged="FundComboBox_SelectionChanged">
                        <ComboBoxItem>Все фонды</ComboBoxItem>
                        <ComboBoxItem>Основной фонд</ComboBoxItem>
                        <ComboBoxItem>Редкий фонд</ComboBoxItem>
                        <ComboBoxItem>Учебный фонд</ComboBoxItem>
                        <ComboBoxItem>Периодика</ComboBoxItem>
                        <ComboBoxItem>Детский фонд</ComboBoxItem>
                        <ComboBoxItem>Научный фонд</ComboBoxItem>
                        <ComboBoxItem>Краеведческий фонд</ComboBoxItem>
                        <ComboBoxItem>Фонд периодических изданий</ComboBoxItem>
                        <ComboBoxItem>Художественный фонд</ComboBoxItem>
                        <ComboBoxItem>Фонд редких книг</ComboBoxItem>
                        <ComboBoxItem>Справочный фонд</ComboBoxItem>
                        <ComboBoxItem>Фонд диссертаций</ComboBoxItem>
                        <ComboBoxItem>Фонд рефератов</ComboBoxItem>
                        <ComboBoxItem>Учебно-методический фонд</ComboBoxItem>
                        <ComboBoxItem>Фонд аудиокниг</ComboBoxItem>
                        <ComboBoxItem>Медиатека</ComboBoxItem>
                        <ComboBoxItem>Фонд периодики</ComboBoxItem>
                        <ComboBoxItem>Молодёжный фонд</ComboBoxItem>
                        <ComboBoxItem>Досуговый фонд</ComboBoxItem>
                        <ComboBoxItem>Фонд нотных изданий</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Кнопки управления -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Сделали кнопки белыми, чтобы они выделялись на синем фоне -->
                <Button Content="Добавить" Width="140" Style="{StaticResource AccentButton}"  Foreground="{StaticResource Accent}" Margin="0,0,15,0" Click="Add_Click"/>
                <Button Content="В архив" Width="140" Style="{StaticResource AccentButton}"  Foreground="{StaticResource Accent}" Click="Delete_Click"/>
                </StackPanel>
            </Grid>

        <!-- Список литературы -->
        <ListView Name="ListViewLibrary"
                  Grid.Row="1"
                  Margin="0,15,0,0"
                  BorderThickness="0"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Padding" Value="16,14"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- ID -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ItemID}"
                                   FontWeight="Bold"
                                   FontSize="28"
                                   VerticalAlignment="Top"/>

                        <!-- Основной контент -->
                        <StackPanel Grid.Column="1" Orientation="Vertical">

                            <!-- Название + Инв. номер в одной строке (чтобы номер подтягивался к названию, если нет автора) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding InventoryNumber}"
                                           FontFamily="Consolas"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Автор (скрывается, если пусто) -->
                            <TextBlock Text="{Binding Author}" FontSize="16" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Author}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Author}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Тип, Фонд, Дата -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Тип: " FontSize="16"/>
                                <TextBlock Text="{Binding LiteratureType.TypeName}" FontSize="16" Margin="0,0,20,0"/>

                                <TextBlock Text="Фонд: " FontSize="16"/>
                                <TextBlock Text="{Binding LibraryFund.FundName}" FontSize="16" Margin="0,0,20,0"/>

                                <TextBlock Text="Дата: " FontSize="16"/>
                                <TextBlock Text="{Binding AddedDate, StringFormat={}{0:dd.MM.yyyy}}" FontSize="16"/>
                            </StackPanel>

                            <!-- Добавил и Библиотека -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Добавил(а): " FontSize="16"/>
                                <TextBlock Text="{Binding Employees.FIO}" FontSize="16" Margin="0,0,15,0"/>
                                <TextBlock Text="{Binding LibraryFund.Library.Name}" FontSize="16"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Статус -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Status}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="В архиве">
                                            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Количество записей -->
        <TextBlock x:Name="CountTextBlock"
                   Grid.Row="2"
                   FontWeight="Bold"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource Accent}"/>

    </Grid>
</Page>